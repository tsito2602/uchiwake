{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uchiwake",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [{ "binding": "DB", "database_name": "uchiwake", "migrations_dir": "migrations" }],
  "ai": { "binding": "AI" },
  "vars": { "APP_ENV": "production", "AI_IMPORT_PROVIDER": "cloudflare", "AI_GATEWAY_ID": "uchiwake" },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
