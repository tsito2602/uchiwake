{
  "name": "uchiwake",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/embed-assets.mjs",
    "bundle:worker": "npm run build && esbuild worker/index.ts --bundle --format=esm --platform=browser --target=es2022 --minify --outfile=dist/worker.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run build && npm run typecheck && node --test tests/*.test.mjs",
    "deploy:staging": "npm run check && wrangler deploy --config wrangler.staging.jsonc",
    "db:staging": "wrangler d1 migrations apply uchiwake-staging --remote --config wrangler.staging.jsonc"
  },
  "dependencies": {
    "hono": "^4.12.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.1",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~6.0.3",
    "vite": "^7.1.0",
    "wrangler": "^4.135.0"
  }
}
