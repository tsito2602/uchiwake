{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uchiwake-staging",
  "main": "worker/index.ts",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "uchiwake-staging", "database_id": "8a984378-6b7e-412f-ac28-3c327d004a2a", "migrations_dir": "migrations" }],
  "ai": { "binding": "AI" },
  "vars": { "APP_ENV": "staging", "AI_IMPORT_PROVIDER": "cloudflare", "AI_GATEWAY_ID": "uchiwake" },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
